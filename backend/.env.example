# API Keys e Credenciais (Preencher com valores reais)
GEMINI_API_KEY=your_gemini_api_key_here   # Google AI Studio (formato novo: AQ.xxxx ; antigo: AIzaxxxx)

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Endpoints internos (/internal/*) — fail-closed: SEM valor aqui, /internal/* responde 403.
# Gerar: `openssl rand -hex 32`. O nginx também bloqueia /internal/ no domínio público;
# o e-mail de boas-vindas hoje é enviado in-process pelo /auth/signup (não depende disto).
INTERNAL_API_TOKEN=

# E-mail de suporte exibido no rodapé dos e-mails transacionais
SUPPORT_EMAIL=plugin@arckosia.com.br

# Nota: Não versionar este arquivo com valores reais!
# Use backend/.env no servidor e adicione ao .gitignore
